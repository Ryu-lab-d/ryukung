VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxx
# Cloudflare Turnstile sitekey (public) — ป้ายยืนยันว่าไม่ใช่บอทตอนลูกค้าสั่งของเองจากหน้าเมนู (/menu)
# สร้างได้ที่ dash.cloudflare.com > Turnstile หรือ `wrangler turnstile widget create` — secret คู่กันตั้งแยก
# ไว้ที่ Supabase Edge Function secrets (TURNSTILE_SECRET_KEY) เท่านั้น ห้ามใส่ secret ในไฟล์ .env ฝั่ง frontend
VITE_TURNSTILE_SITE_KEY=
TEST_USER_EMAIL=you@example.com
TEST_USER_PASSWORD=your-password
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx
# ตัวเลือกเสริม: URL ของ Google Apps Script Web App สำหรับสำรองออเดอร์ไป Google Sheets ก่อนลบถาวร (ดู src/lib/sheetsArchive.ts)
VITE_SHEETS_ARCHIVE_WEBHOOK_URL=
# ตัวเลือกเสริม: URL ของ Google Apps Script Web App คนละตัวสำหรับบันทึกรายการเบิกของไปขายนอกร้าน (ดู src/lib/sheetsArchive.ts)
VITE_SHEETS_WITHDRAWAL_WEBHOOK_URL=
# ตัวเลือกเสริม: URL ของ Google Apps Script Web App สำหรับ sync ข้อมูล 8 แท็บไป Google Sheets (npm run sync:sheets)
# ดูวิธีตั้งค่าใน scripts/googleAppsScriptSync.gs
GOOGLE_SHEETS_SYNC_WEBHOOK_URL=
